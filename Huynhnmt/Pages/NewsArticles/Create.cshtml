@page
@model Huynhnmt_SE17C04_A02.Pages.NewsArticles.CreateModel
@{
    ViewData["Title"] = "Create News Article";
}

<h1>Create News Article</h1>

<form method="post">
    <div class="form-group">
        <label>Title</label>
        <input asp-for="NewsArticle.NewsTitle" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Headline</label>
        <input asp-for="NewsArticle.Headline" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Category</label>
        <select asp-for="NewsArticle.CategoryId" asp-items="Model.CategoryList" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Content</label>
        <textarea asp-for="NewsArticle.NewsContent" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
