@page
@model Huynhnmt_SE17C04_A02.Pages.NewsArticles.EditModel
@{
    ViewData["Title"] = "Edit News Article";
}

<h1>Edit News Article</h1>

<form method="post">
    <input type="hidden" asp-for="NewsArticle.NewsArticleId" />

    <div class="form-group">
        <label>Title</label>
        <input asp-for="NewsArticle.NewsTitle" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Headline</label>
        <input asp-for="NewsArticle.Headline" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Category</label>
        <select asp-for="NewsArticle.CategoryId" asp-items="Model.CategoryList" class="form-control"></select>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
