@model IEnumerable<DataLayer.Entities.Category>
@{
    ViewData["Title"] = "Category Management";
}

<div class="container mt-4">
    <h2 class="mb-3">Category Management</h2>

    <!-- Search Box -->
    <form method="get" class="input-group mb-3">
        <input type="text" name="search" class="form-control" placeholder="Search categories" value="@ViewData["SearchQuery"]">
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <!-- Add Category Button -->
    <button class="btn btn-success mb-3" onclick="openCreateModal()">+ Add New Category</button>

    <!-- Table -->
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>
                        <span class="badge @(category.Status ? "bg-success" : "bg-danger")">
                            @(category.Status ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm" onclick="openEditModal(@category.Id)">Edit</button>
                        <button class="btn btn-danger btn-sm" onclick="openDeleteModal(@category.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Placeholder -->
<div id="modalPlaceholder"></div>

@section Scripts {
    <script>
        function openCreateModal() {
            $.get('/Category/Create', function (data) {
                $('#modalPlaceholder').html(data);
                new bootstrap.Modal(document.getElementById('modalCreate')).show();
            });
        }

        function openEditModal(id) {
            $.get('/Category/Edit/' + id, function (data) {
                $('#modalPlaceholder').html(data);
                new bootstrap.Modal(document.getElementById('modalEdit')).show();
            });
        }

        function openDeleteModal(id) {
            $.get('/Category/Delete/' + id, function (data) {
                $('#modalPlaceholder').html(data);
                new bootstrap.Modal(document.getElementById('modalDelete')).show();
            });
        }
    </script>
}
