@page "/Auth/Register"
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form method="post">
    <div class="mb-3">
        <label for="FullName" class="form-label">Full Name</label>
        <input type="text" class="form-control" id="FullName" name="FullName" asp-for="RegisterData.FullName" required />
        <span class="text-danger" asp-validation-for="RegisterData.FullName"></span>
    </div>
    <div class="mb-3">
        <label for="Email" class="form-label">Email</label>
        <input type="email" class="form-control" id="Email" name="Email" asp-for="RegisterData.Email" required />
        <span class="text-danger" asp-validation-for="RegisterData.Email"></span>
    </div>
    <div class="mb-3">
        <label for="Password" class="form-label">Password</label>
        <input type="password" class="form-control" id="Password" name="Password" asp-for="RegisterData.Password" required />
        <span class="text-danger" asp-validation-for="RegisterData.Password"></span>
    </div>
    <div class="mb-3">
        <label for="ConfirmPassword" class="form-label">Confirm Password</label>
        <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" asp-for="RegisterData.ConfirmPassword" required />
        <span class="text-danger" asp-validation-for="RegisterData.ConfirmPassword"></span>
    </div>
    @* <div class="mb-3"> *@
    @*     <label for="Role" class="form-label">Role</label> *@
    @*     <select class="form-select" id="Role" name="Role" asp-for="RegisterData.Role" required> *@
    @*         <option value="2">Student</option> *@
    @*         <option value="1">Admin</option> *@
    @*     </select> *@
    @* </div> *@

    <button type="submit" class="btn btn-primary">Register</button>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info mt-3">@Model.Message</div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
